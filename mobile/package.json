{
  "name": "life-workbench-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor shell that wraps the workbench page into an installable Android app",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
