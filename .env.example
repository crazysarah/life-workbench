# 复制成 .env 再改：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交。

# ============ 必填 ============
# 访问口令：手机 APP 首次打开时输入这个，之后不用再输。
# 请改成你自己的，别用示例值。
APP_PASSWORD=change-me-please

# ============ 建议填 ============
# 用于派生登录 token（HMAC 密钥）。改这个会让所有已登录设备失效并需重新输入口令。
# 随便打一串长随机字符即可。
APP_SECRET=change-me-to-a-long-random-string

# ============ 数据存放位置 ============
# 留空（推荐）→ 用 docker 卷 lw-data，属主自动正确，最省心。
#              备份：docker compose cp api:/data/workbench.db ./备份.db
# ./data       → 存到仓库目录下的 data/，文件在宿主机上直接可见。
#              用这个必须先建目录并授权，否则容器起不来（报 SQLITE_CANTOPEN）：
#                mkdir -p data && sudo chown -R 1000:1000 data
#              原因：容器里跑的是 uid 1000 的 node，而 docker 自动建的目录属于 root。
DATA_VOLUME=

# ============ 监听端口 ============
# 默认 8080。国内云服务器安全组要放行这个端口（只在直连模式下需要）。
HTTP_PORT=8080

# 监听地址。三种情况按需选一：
#   1) 直接 IP 访问（最简单）        → 留空即可，等于 0.0.0.0
#   2) 本机已有 nginx 等反代          → 填 127.0.0.1，只对本机开放，不对外暴露
#   3) 反代跑在同一个 docker 网络     → 填 127.0.0.1，
#                                      再把 docker-compose.yml 里 api 的 ports 两行删掉，
#                                      反代上游填 http://life-workbench-api:8080
BIND_ADDR=

# ============ 服务器对外地址（自己填）============
# 部署好之后填这里，就是手机要连的地址：
#   http://你的公网IP:端口        例：http://203.0.113.10:8080
#   https://你的域名             例：https://life.example.com
# 留空的话，部署脚本会自动探测公网 IP 再拼上端口。
PUBLIC_BASE_URL=

# 注意：构建 APK 用的 GitHub Actions 读不到这个文件，
# 同一个地址还要在 GitHub 仓库里配一份：
#   Settings → Secrets and variables → Actions → Variables → New variable
#   名称：API_BASE    值：和上面的 PUBLIC_BASE_URL 一样

# ============ 域名 + HTTPS（可选）============
# 下面这两项【只在使用仓库自带的 Caddy】时才需要，用它启动：
#   docker compose -f docker-compose.yml -f deploy/docker-compose.caddy.yml up -d --build
#
# 自己已经有反代（nginx / Traefik / 别的 Caddy）就【留空不用管】，
# 这两个变量跟你自己那套无关，留空不会影响 docker compose up。
DOMAIN=
ACME_EMAIL=
