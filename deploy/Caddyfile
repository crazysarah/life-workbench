# Caddy 反向代理 —— 自动申请并续期 Let's Encrypt 证书
#
# 只在叠加 deploy/docker-compose.caddy.yml 时才会被用到：
#   docker compose -f docker-compose.yml -f deploy/docker-compose.caddy.yml up -d --build
#
# 已有自建反代的，这个文件跟你的部署无关，可以忽略。

{
	email {$ACME_EMAIL}
	# 国内服务器如果走不了 ACME，可以换用 ZeroSSL；香港/首尔直连没问题。
}

{$DOMAIN} {
	encode zstd gzip

	# 工作台是单文件页面，禁掉缓存避免改版后拿到旧版本
	@static {
		not path /api/*
	}
	header @static Cache-Control "no-cache"

	reverse_proxy api:8080 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format console
	}
}
