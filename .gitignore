# 依赖
node_modules/

# 运行数据（SQLite 主库 + WAL），绝不能进仓库
data/
*.db
*.db-wal
*.db-shm

# 环境变量（含口令）
.env
.env.local

# 签名私钥：绝不入库。私钥放 GitHub Secret（LW_DEBUG_KEYSTORE），
# 构建时还原；仓库里只留指纹 build/signing-cert.sha256
*.p12
*.jks
*.keystore

# 原始参考页（构建输入，不入库）
_src/

# 安卓工程：由 `npx cap add android` 自动生成，不入库（避免平台 SDK 版本漂移）
# 首次构建执行：bash build/sync_mobile.sh <服务端地址>
mobile/android/
mobile/www/
mobile/node_modules/
mobile/package-lock.json

# 杂项
*.log
.DS_Store
Thumbs.db
__pycache__/
